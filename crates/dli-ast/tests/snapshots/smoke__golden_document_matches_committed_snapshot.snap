              "start": 6398,
              "end": 6411
            }
          },
          {
            "text": "stress penultimate",
            "span": {
              "file": 0,
              "start": 6414,
              "end": 6432
            }
          },
          {
            "text": "name-kind person.given = given-proto given-deutero",
            "span": {
              "file": 0,
              "start": 6435,
              "end": 6485
            }
          },
          {
            "text": "name-part myr \"sea\" role given-proto proposed",
            "span": {
