    {
      "Practice": {
        "name": {
          "text": "oath-binding",
          "span": {
            "file": 0,
            "start": 10368,
            "end": 10380
          }
        },
        "body": [
          {
            "text": "use chronology.cycles",
            "span": {
              "file": 0,
              "start": 10395,
              "end": 10416
            }
          },
          {
            "text": "kind bond = fealty | troth | ransom",
            "span": {
              "file": 0,
              "start": 10482,
              "end": 10517
            }
          },
          {
            "text": "role oathgiver : person requires standing(oathgiver)",
            "span": {
              "file": 0,
              "start": 10520,
              "end": 10575
            }
          },
          {
            "text": "role oathholder : person requires consent(oathholder)",
            "span": {
              "file": 0,
              "start": 10578,
              "end": 10633
            }
          },
          {
            "text": "resource boon : linear conserved",
            "span": {
              "file": 0,
              "start": 10636,
              "end": 10670
            }
          },
          {
            "text": "resource strain : affine bounded body-limit",
            "span": {
              "file": 0,
              "start": 10727,
              "end": 10770
            }
          },
          {
            "text": "rule pledge(bond, oathgiver)",
            "span": {
              "file": 0,
              "start": 10809,
              "end": 10837
            }
          },
          {
            "text": "rule give-and-take",
            "span": {
              "file": 0,
              "start": 10840,
              "end": 10858
            }
          },
          {
            "text": "condition witnessed requires witness within earshot",
            "span": {
              "file": 0,
              "start": 10941,
              "end": 10992
            }
          },
          {
            "text": "error unowed refines L2 premise-not-available where absent",
            "span": {
              "file": 0,
              "start": 10995,
              "end": 11060
            }
          },
          {
            "text": "error forsworn refines L2 premise-not-available where contradicted signals dishonour",
            "span": {
              "file": 0,
              "start": 11126,
              "end": 11215
            }
          },
          {
            "text": "error wrong-moon refines L3 side-condition [timing] over cycle moon",
            "span": {
              "file": 0,
              "start": 11295,
              "end": 11365
            }
          },
          {
            "text": "error overpledged refines L6 resource-violation on strain signals collapse",
            "span": {
              "file": 0,
              "start": 11443,
              "end": 11519
            }
          },
          {
            "text": "error hollow-vow refines L2 where available-in(licensed-pool) and contradicted-in(certain)",
            "span": {
              "file": 0,
              "start": 11594,
              "end": 11687
            }
          },
          {
            "text": "cost social | bodily | material | epistemic",
            "span": {
              "file": 0,
              "start": 11786,
              "end": 11829
            }
          }
        ],
        "provenance": {
          "marker": "Proposed",
          "citations": [],
          "condition": null,
          "tags": [],
          "span": {
            "file": 0,
            "start": 10382,
            "end": 10390
          }
        }
      }
    },
    {
      "Proof": {
        "name": {
          "text": "lancelots-oath",
          "span": {
            "file": 0,
            "start": 12581,
            "end": 12595
          }
        },
        "head": [
          "speaker",
          "lancelot",
          "in",
          "oath-binding"
        ],
        "body": [
          {
            "text": "premise p1 standing(lancelot) cited d-0012 cue \"Lancelot comes to court\"",
            "span": {
              "file": 0,
              "start": 12635,
              "end": 12710
            }
          },
          {
            "text": "premise p2 consent(arthur) cited d-0012",
            "span": {
              "file": 0,
              "start": 12713,
              "end": 12757
            }
          },
          {
            "text": "premise p3 boon(1) drawn-against p1",
            "span": {
              "file": 0,
              "start": 12760,
              "end": 12808
            }
          },
          {
            "text": "step s1 instantiate pledge with bond = fealty, oathgiver = lancelot",
            "span": {
              "file": 0,
              "start": 12811,
              "end": 12882
            }
          },
          {
            "text": "step s2 chain from p1, s1 by give-and-take conclusion pledged(lancelot, fealty)",
            "span": {
              "file": 0,
              "start": 12885,
              "end": 12967
            }
          },
          {
            "text": "spend p3",
            "span": {
              "file": 0,
              "start": 12970,
              "end": 12979
            }
          },
          {
            "text": "close pledged(lancelot, fealty) expect holds",
            "span": {
              "file": 0,
              "start": 12982,
              "end": 13028
            }
          }
        ]
      }
