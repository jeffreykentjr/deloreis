    {
      "Practice": {
        "name": {
          "text": "merlins-craft",
          "span": {
            "file": 0,
            "start": 8936,
            "end": 8949
          }
        },
        "body": [
          {
            "text": "use language.registers",
            "span": {
              "file": 0,
              "start": 8964,
              "end": 8986
            }
          },
          {
            "text": "resource breath(word) : graded monotone full > spent > silent",
            "span": {
              "file": 0,
              "start": 9042,
              "end": 9103
            }
          },
          {
            "text": "rule speak(bearer) requires",
            "span": {
              "file": 0,
              "start": 9106,
              "end": 9133
            }
          },
          {
            "text": "knows(caster, true-name(bearer)),",
            "span": {
              "file": 0,
              "start": 9140,
              "end": 9173
            }
          },
          {
            "text": "breath(true-name(bearer)) >= spent,",
            "span": {
              "file": 0,
              "start": 9180,
              "end": 9215
            }
          },
          {
            "text": "derivation(true-name(bearer)) checks in register-of(bearer)",
            "span": {
              "file": 0,
              "start": 9222,
              "end": 9281
            }
          },
          {
            "text": "effect speak degrades breath by 1",
            "span": {
              "file": 0,
              "start": 9284,
              "end": 9317
            }
          },
          {
            "text": "condition unheard requires no witness within earshot",
            "span": {
              "file": 0,
              "start": 9367,
              "end": 9419
            }
          },
          {
            "text": "error mis-spoken refines L4 bad-instantiation",
            "span": {
              "file": 0,
              "start": 9422,
              "end": 9471
            }
          },
          {
            "text": "error stale-name refines L2 where premise-outdated",
            "span": {
              "file": 0,
              "start": 9549,
              "end": 9603
            }
          },
          {
            "text": "error word-overheard refines L3 side-condition [unheard] signals degrade(+1)",
            "span": {
              "file": 0,
              "start": 9681,
