{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttestationSweepParams",
  "description": "`dli.attestation-sweep` params.",
  "type": "object",
  "properties": {
    "store": {
      "description": "The attestation store to sweep.",
      "$ref": "#/$defs/AttestationStore"
    }
  },
  "required": [
    "store"
  ],
  "$defs": {
    "Attestation": {
      "description": "A recorded model answer to a question, with everything needed to decide\nwhether it is still current.",
      "type": "object",
      "properties": {
        "answer": {
          "description": "The recorded answer.",
          "type": "string"
        },
        "model": {
          "description": "The model that produced it.",
          "type": "string"
        },
        "params": {
          "description": "The generation parameters (name to rendered value).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "policy": {
          "description": "The policy under which the attestation was taken.",
          "type": "string"
        },
        "prompt": {
          "description": "The prompt sent.",
          "type": "string"
        },
        "question": {
          "description": "The question posed.",
          "type": "string"
        },
        "supersedes": {
          "description": "A prior attestation this one supersedes, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "sweep": {
          "description": "The sweep fingerprint the attestation was valid under.",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer",
        "model",
        "prompt",
        "params",
        "policy",
        "sweep"
      ]
    },
    "AttestationStore": {
      "description": "The store of recorded attestations.",
      "type": "object",
      "properties": {
        "attestations": {
          "description": "Every recorded attestation.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attestation"
          }
        }
      },
      "required": [
        "attestations"
      ]
    }
  }
}
