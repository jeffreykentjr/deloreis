{
  "fixture": "golden/timeline-knows-v1",
  "version": 1,
  "note": "dli.timeline.knows is the knowledge-fluent projection: what the listener knows once production has reached a slot (knowledge is inertial). Absent `at`, the whole season has played; `at` names an earlier production slot. Read over the neutral round-table season.",
  "steps": [
    {
      "send": {
        "dli": "0.1.0",
        "id": "1",
        "op": "dli.timeline.knows",
        "params": {
          "document": "round-table"
        }
      },
      "expect": {
        "dli": "0.1.0",
        "id": "1",
        "ok": true,
        "result": {
          "findings": [
            "at slot 3, the listener knows:",
            "  the-battle-of-camlann",
            "  the-round-table-founded",
            "  the-sword-drawn"
          ]
        }
      }
    },
    {
      "send": {
        "dli": "0.1.0",
        "id": "2",
        "op": "dli.timeline.knows",
        "params": {
          "document": "round-table",
          "at": "2"
        }
      },
      "expect": {
        "dli": "0.1.0",
        "id": "2",
        "ok": true,
        "result": {
          "findings": [
            "at slot 2, the listener knows:",
            "  the-round-table-founded",
            "  the-sword-drawn"
          ]
        }
      }
    }
  ]
}
