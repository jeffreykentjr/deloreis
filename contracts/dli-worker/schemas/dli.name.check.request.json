{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NameCheckParams",
  "description": "`dli.name.check` params.",
  "type": "object",
  "properties": {
    "dialect": {
      "description": "The dialect to vet against.",
      "type": "string"
    },
    "name": {
      "description": "The proposed name.",
      "type": "string"
    },
    "workspace": {
      "description": "Optional authoring workspace whose base and staged dialects are used.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "dialect"
  ]
}
