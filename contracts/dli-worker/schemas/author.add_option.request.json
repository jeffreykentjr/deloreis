{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorAddOptionParams",
  "description": "`author.add_option` params.",
  "type": "object",
  "properties": {
    "id": {
      "description": "The option id.",
      "type": "string"
    },
    "implies": {
      "description": "A ground claim supported by this option while the question is open.",
      "anyOf": [
        {
          "$ref": "#/$defs/AtomExpr"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "description": "The option label.",
      "type": "string"
    },
    "question": {
      "description": "The question id this option belongs to.",
      "type": "string"
    },
    "workspace": {
      "description": "The workspace id.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "workspace",
    "question",
    "id",
    "label"
  ],
  "$defs": {
    "AtomExpr": {
      "description": "A predicate applied to a list of argument terms, e.g. `adjacent(a, b)`.",
      "type": "object",
      "properties": {
        "args": {
          "description": "The argument terms, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          }
        },
        "pred": {
          "description": "The predicate name.",
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "pred",
        "args"
      ]
    },
    "FileId": {
      "description": "Identifier for a source file within a compilation.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "Ident": {
      "description": "A named identifier. Either the bare text, whose span is synthetic, or an object carrying the text and an optional span.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "span": {
              "description": "A half-open byte range within a single source file.",
              "type": "object",
              "properties": {
                "end": {
                  "description": "End byte offset (exclusive).",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "file": {
                  "description": "The file this span points into.",
                  "$ref": "#/$defs/FileId"
                },
                "start": {
                  "description": "Start byte offset (inclusive).",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "file",
                "start",
                "end"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        }
      ]
    },
    "Term": {
      "description": "A term: a variable, symbol, literal, or time reference.",
      "oneOf": [
        {
          "description": "A logic variable (unifies during evaluation).",
          "type": "object",
          "properties": {
            "Var": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Var"
          ]
        },
        {
          "description": "A ground symbol naming an entity.",
          "type": "object",
          "properties": {
            "Sym": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Sym"
          ]
        },
        {
          "description": "A string literal.",
          "type": "object",
          "properties": {
            "Str": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Str"
          ]
        },
        {
          "description": "An integer literal.",
          "type": "object",
          "properties": {
            "Int": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "Int"
          ]
        },
        {
          "description": "A reference into the time domain.",
          "type": "object",
          "properties": {
            "Time": {
              "$ref": "#/$defs/TimeRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "Time"
          ]
        }
      ]
    },
    "TimeRef": {
      "description": "A reference to a named era or event on the timeline.",
      "oneOf": [
        {
          "description": "A named era (a span).",
          "type": "object",
          "properties": {
            "Era": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Era"
          ]
        },
        {
          "description": "A named event (a point).",
          "type": "object",
          "properties": {
            "Event": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Event"
          ]
        }
      ]
    }
  }
}
