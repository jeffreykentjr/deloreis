{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorAddFactParams",
  "description": "`author.add_fact` params: an attribute-intent fact that renders\n`entity.key = value` (e.g. `nara.home = riverside`).",
  "type": "object",
  "properties": {
    "entity": {
      "description": "The entity the attribute is set on.",
      "type": "string"
    },
    "key": {
      "description": "The attribute key.",
      "type": "string"
    },
    "provenance": {
      "description": "The provenance of this addition.",
      "$ref": "#/$defs/Provenance"
    },
    "value": {
      "description": "The attribute value.",
      "type": "string"
    },
    "workspace": {
      "description": "The workspace id.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "workspace",
    "entity",
    "key",
    "value",
    "provenance"
  ],
  "$defs": {
    "Provenance": {
      "description": "Provenance supplied when adding authored material. Internally tagged on\n`kind`; origin tracking is load-bearing for the authoring seam (nothing an agent supplies\nmints authority).",
      "oneOf": [
        {
          "description": "Cited to one or more decisions: `{\"kind\":\"cited\",\"decisions\":[\"D-0104\"]}`.",
          "type": "object",
          "properties": {
            "decisions": {
              "description": "The cited decision identifiers in the consuming repo's ledger.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "cited"
            },
            "state": {
              "description": "The requested standing for the cited claim.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ProvenanceState"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "decisions"
          ]
        },
        {
          "description": "Proposed (not yet ratified): `{\"kind\":\"proposed\",\"origin\":\"session-7c9\"}`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "proposed"
            },
            "origin": {
              "description": "The origin token of the proposal (e.g. an agent session id).",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "description": "Conditional on a hypothesis: `{\"kind\":\"hypothesis\",\"hyp\":\"coast-runs-north\"}`.",
          "type": "object",
          "properties": {
            "hyp": {
              "description": "The hypothesis the material is conditioned on.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "hypothesis"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hyp"
          ]
        }
      ]
    },
    "ProvenanceState": {
      "description": "The stored standing requested for a cited authoring operation.\n\nCited provenance requires this field at the request boundary.",
      "oneOf": [
        {
          "description": "Open to later revision.",
          "type": "string",
          "const": "provisional"
        },
        {
          "description": "A settled ruling.",
          "type": "string",
          "const": "ratified"
        }
      ]
    }
  }
}
