{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulateStartResult",
  "description": "`dli.simulate.start` result.",
  "type": "object",
  "properties": {
    "job_id": {
      "description": "The job id to poll.",
      "type": "string"
    },
    "status": {
      "description": "The initial job status.",
      "$ref": "#/$defs/SimulateJobStatus"
    }
  },
  "required": [
    "job_id",
    "status"
  ],
  "$defs": {
    "SimulateJobStatus": {
      "description": "A durable simulation job's lifecycle state.",
      "oneOf": [
        {
          "description": "Reserved and ready to advance.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "At least one checkpoint has been committed.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "A final manifest has been committed.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Cancellation was committed before completion.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    }
  }
}
