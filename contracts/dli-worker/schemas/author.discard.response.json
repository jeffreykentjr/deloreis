{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorDiscardResult",
  "description": "`author.discard` result.",
  "type": "object",
  "properties": {
    "discarded": {
      "description": "Whether the workspace was discarded.",
      "type": "boolean"
    },
    "workspace_digest": {
      "description": "The workspace digest after a single-declaration discard; absent when the\nwhole workspace was discarded.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "discarded"
  ]
}
