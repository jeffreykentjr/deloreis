{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VersionResult",
  "description": "`dli.version` result.",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "The wire op names this build actually implements — capability negotiation\n(spec `10-serving.md` §2), so a consumer can degrade rather than call an op\nthe running build has not wired. Defaulted for N-1 payloads without it.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "contract": {
      "description": "The contract name.",
      "type": "string"
    },
    "contract_version": {
      "description": "The contract version.",
      "type": "string"
    },
    "server": {
      "description": "The server version.",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "contract_version",
    "server"
  ]
}
