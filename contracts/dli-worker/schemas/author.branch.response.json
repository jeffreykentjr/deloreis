{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorBranchResult",
  "description": "`author.branch` result.",
  "type": "object",
  "properties": {
    "branches": {
      "description": "Every branch name after the action, `main` first.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "description": "The branch just created (`create` only).",
      "type": [
        "string",
        "null"
      ]
    },
    "heads": {
      "description": "Every branch's head commit and ref digest —\n`expected_ref`'s source material for a subsequent `author.merge` or\n`author.branch` `delete`/`create` fence.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/BranchHead"
      }
    }
  },
  "required": [
    "branches"
  ],
  "$defs": {
    "BranchHead": {
      "description": "One branch's head, in an `author.branch` result.",
      "type": "object",
      "properties": {
        "commit": {
          "description": "The branch's head commit hash.",
          "type": "string"
        },
        "name": {
          "description": "The branch name.",
          "type": "string"
        },
        "ref_digest": {
          "description": "The branch ref's whole-ref digest — the fence `author.merge`'s and\n`author.branch`'s `expected_ref` check against.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "commit",
        "ref_digest"
      ]
    }
  }
}
