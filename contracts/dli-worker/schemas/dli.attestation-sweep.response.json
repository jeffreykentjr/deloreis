{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttestationSweepResult",
  "description": "`dli.attestation-sweep` result.",
  "type": "object",
  "properties": {
    "accepted": {
      "description": "Number of records accepted.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "batch_digest": {
      "description": "SHA-256 address of the immutable append batch.",
      "type": "string"
    }
  },
  "required": [
    "accepted",
    "batch_digest"
  ]
}
