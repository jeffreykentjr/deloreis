{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForkAddParams",
  "description": "`dli.fork.add` params.",
  "type": "object",
  "properties": {
    "additions": {
      "description": "Proposed facts as typed ground atoms, asserted in the fork.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/GroundAtom"
      }
    },
    "declarations": {
      "description": "Retired text form; use [`Self::additions`].",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "fork": {
      "description": "The fork handle.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "fork"
  ],
  "$defs": {
    "GroundAtom": {
      "description": "A ground atom: a predicate applied to fully-ground argument renderings. This\nis the identity of a fact or a derived tuple in the relation.",
      "type": "object",
      "properties": {
        "args": {
          "description": "The ground argument renderings, in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pred": {
          "description": "The predicate name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pred",
        "args"
      ]
    }
  }
}
