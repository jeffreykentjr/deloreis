{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorQueryParams",
  "description": "`author.query` params: query the **staged** world (base + staged\ndeclarations). The agent asks \"what holds about `lyra` now?\" over its\nin-progress work.",
  "type": "object",
  "properties": {
    "goal": {
      "description": "Retired text form; use [`Self::goal_atom`].",
      "type": "string",
      "default": ""
    },
    "goal_atom": {
      "description": "The structured goal atom; a `Term::Var` argument is a query variable.",
      "anyOf": [
        {
          "$ref": "#/$defs/AtomExpr"
        },
        {
          "type": "null"
        }
      ]
    },
    "layer": {
      "description": "The standing floor for the returned rows (`certain` | `possible` | `all`).\nAbsent means `all` — no floor.",
      "anyOf": [
        {
          "$ref": "#/$defs/Layer"
        },
        {
          "type": "null"
        }
      ]
    },
    "why": {
      "description": "Attach the support antichain (`why`) to every row.",
      "type": "boolean",
      "default": false
    },
    "workspace": {
      "description": "The workspace id.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "workspace"
  ],
  "$defs": {
    "AtomExpr": {
      "description": "A predicate applied to a list of argument terms, e.g. `adjacent(a, b)`.",
      "type": "object",
      "properties": {
        "args": {
          "description": "The argument terms, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          }
        },
        "pred": {
          "description": "The predicate name.",
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "pred",
        "args"
      ]
    },
    "FileId": {
      "description": "Identifier for a source file within a compilation.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "Ident": {
      "description": "A named identifier. Either the bare text, whose span is synthetic, or an object carrying the text and an optional span.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "span": {
              "description": "A half-open byte range within a single source file.",
              "type": "object",
              "properties": {
                "end": {
                  "description": "End byte offset (exclusive).",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "file": {
                  "description": "The file this span points into.",
                  "$ref": "#/$defs/FileId"
                },
                "start": {
                  "description": "Start byte offset (inclusive).",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "file",
                "start",
                "end"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        }
      ]
    },
    "Layer": {
      "description": "The standing floor a query answer is filtered to.\n\nA `Layer` is a **minimum-standing floor** on the answer rows: a row is kept\nwhen its [`Status`] is at least the floor. Because `Status` orders\n`Dead < Possible < Certain`, the layers nest — `Certain ⊆ Possible ⊆ All`:\n\n- [`Layer::Certain`] keeps only assertable rows (`Status::Certain`).\n- [`Layer::Possible`] keeps the shadow **and** the certain layer\n  (`Status::Possible` and `Status::Certain`). Possibility does not exclude\n  certainty: a certain claim is a fortiori possible.\n- [`Layer::All`] applies no floor — the default.\n\n**Dead atoms never appear in any layer.** A claim whose every monomial is\n`Θ`-unsatisfiable is fail-closed-excluded from the evaluated surface\n(`02-semantics.md` §3: \"excluded from every layer except the error report\").\nSo `Possible` and `All` return the same rows on today's query surface and\ndiffer only in declared intent; surfacing dead atoms is the error report's\njob, not a query layer's.",
      "oneOf": [
        {
          "description": "Only assertable rows.",
          "type": "string",
          "const": "certain"
        },
        {
          "description": "The shadow layer and the certain layer together.",
          "type": "string",
          "const": "possible"
        },
        {
          "description": "No standing floor.",
          "type": "string",
          "const": "all"
        }
      ]
    },
    "Term": {
      "description": "A term: a variable, symbol, literal, or time reference.",
      "oneOf": [
        {
          "description": "A logic variable (unifies during evaluation).",
          "type": "object",
          "properties": {
            "Var": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Var"
          ]
        },
        {
          "description": "A ground symbol naming an entity.",
          "type": "object",
          "properties": {
            "Sym": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Sym"
          ]
        },
        {
          "description": "A string literal.",
          "type": "object",
          "properties": {
            "Str": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Str"
          ]
        },
        {
          "description": "An integer literal.",
          "type": "object",
          "properties": {
            "Int": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "Int"
          ]
        },
        {
          "description": "A reference into the time domain.",
          "type": "object",
          "properties": {
            "Time": {
              "$ref": "#/$defs/TimeRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "Time"
          ]
        }
      ]
    },
    "TimeRef": {
      "description": "A reference to a named era or event on the timeline.",
      "oneOf": [
        {
          "description": "A named era (a span).",
          "type": "object",
          "properties": {
            "Era": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Era"
          ]
        },
        {
          "description": "A named event (a point).",
          "type": "object",
          "properties": {
            "Event": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Event"
          ]
        }
      ]
    }
  }
}
