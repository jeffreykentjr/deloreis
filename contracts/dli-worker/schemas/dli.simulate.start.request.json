{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulateStartParams",
  "description": "`dli.simulate.start` params.",
  "type": "object",
  "properties": {
    "checkpoint_every": {
      "description": "Trials folded between durable checkpoints.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "document": {
      "description": "The document id.",
      "type": "string"
    },
    "seed": {
      "description": "The RNG seed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "trials": {
      "description": "The number of trials to simulate.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "document",
    "seed",
    "trials",
    "checkpoint_every"
  ]
}
