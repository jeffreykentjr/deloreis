{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrecedenceTier",
  "description": "The world's precedence tier — the generic pillar mechanism, world-populated.\nThe tier that wins a conflict plus the standing-rule text.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The tier name (`pillar`).",
      "type": "string"
    },
    "standing_rule": {
      "description": "The standing-rule statement (the `pillars-win-standing-rule` meta-rule).",
      "type": "string"
    },
    "wins_over": {
      "description": "What the tier wins over (`all-other-families`).",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "wins_over",
    "standing_rule"
  ]
}
