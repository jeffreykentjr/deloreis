{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeatLexiconsFile",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TextMatchRuleCfg"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "TextMatchRuleCfg": {
      "description": "A caller-defined lexical finding over one outline slot.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Full `outline.*` finding code.",
          "type": "string"
        },
        "message": {
          "description": "Finding message.",
          "type": "string"
        },
        "pairs": {
          "description": "Adjacent-token matches.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenPairCfg"
          }
        },
        "single": {
          "description": "Single-token matches.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slot": {
          "description": "Outline slot to scan.",
          "$ref": "#/$defs/TurnSlot"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "slot"
      ]
    },
    "TokenPairCfg": {
      "description": "One adjacent-token pattern in a configured lexical rule.",
      "type": "object",
      "properties": {
        "leads": {
          "description": "Allowed first tokens.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tail": {
          "description": "Required second token.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "leads",
        "tail"
      ]
    },
    "TurnSlot": {
      "description": "Which kishōtenketsu slot names the *turn* the outline battle-scan reads. The\n`ki`/`shō`/`ten`/`ketsu` fields stay on the outline (kishōtenketsu is a named\nframework, not world content); the catalog drives only *which* slot is scanned.",
      "oneOf": [
        {
          "description": "The opening image.",
          "type": "string",
          "const": "ki"
        },
        {
          "description": "The development.",
          "type": "string",
          "const": "sho"
        },
        {
          "description": "The turn.",
          "type": "string",
          "const": "ten"
        },
        {
          "description": "The resolution.",
          "type": "string",
          "const": "ketsu"
        }
      ]
    }
  }
}
