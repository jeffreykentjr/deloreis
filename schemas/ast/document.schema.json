    "RuleDecl": {
      "description": "`rule <name> [over <domain>] …` — header plus captured body clauses.",
      "type": "object",
      "properties": {
        "body": {
          "description": "The captured body clauses (`: … requires …` or `:- …`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          }
        },
        "domain": {
          "description": "The domain the rule is enforced over: `None` is a world rule, `over order`\nan episode-ordering constraint, `over season` a season-ledger rule.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleDomain"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "description": "Header tokens after the name (and any `over <domain>`), before the body\n(e.g. `severity error`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "description": "The rule name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "head",
        "body"
      ]
    },
    "RuleDomain": {
      "description": "The domain a `rule` is enforced over, routing it to the right checker engine.\n\nA rule with no domain is a world (derivation) rule; `over order` routes to the\nepisode-ordering engine, `over season` to the season-ledger engine. The three\nforms unify the surface under one `rule` keyword (the domain is stated, not\nkeyword-encoded).",
      "oneOf": [
        {
          "description": "`over order` — an episode-ordering constraint.",
          "type": "string",
          "const": "order"
        },
        {
          "description": "`over season` — a season-ledger (craft) rule.",
          "type": "string",
          "const": "season"
        }
      ]
    },
    "ScopeHeader": {
      "description": "A `scope <name>` header naming what the document's claims are about.",
