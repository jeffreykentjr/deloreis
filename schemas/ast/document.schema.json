{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document",
  "description": "A parsed source document: an optional scope header plus its declarations.",
  "type": "object",
  "properties": {
    "decls": {
      "description": "The declarations in source order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Decl"
      }
    },
    "scope": {
      "description": "The scope header, if the document opens with one.",
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeHeader"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "decls"
  ],
  "$defs": {
    "Annotation": {
      "description": "Provenance attached to a lore-bearing declaration.",
      "type": "object",
      "properties": {
        "citations": {
          "description": "Supporting citations.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CitationRef"
          }
        },
        "condition": {
          "description": "Optional hypothesis condition under which the claim is asserted\n(`assumes <hyp>`).",
          "anyOf": [
            {
              "$ref": "#/$defs/CondExpr"
            },
            {
              "type": "null"
            }
          ]
        },
        "marker": {
          "description": "The leading provenance word.",
          "$ref": "#/$defs/ProvenanceMarker"
        },
        "span": {
          "description": "Where the annotation appears in source.",
          "$ref": "#/$defs/Span"
        },
        "tags": {
          "description": "Further provenance tokens carried verbatim — an agent id, a session tag,\na scene cue. Retained so nothing on the line is dropped (koan 4).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "marker",
        "citations",
        "tags",
        "span"
      ]
    },
    "AtomExpr": {
      "description": "A predicate applied to a list of argument terms, e.g. `adjacent(a, b)`.",
      "type": "object",
      "properties": {
        "args": {
          "description": "The argument terms, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          }
        },
        "pred": {
          "description": "The predicate name.",
          "$ref": "#/$defs/Ident"
        }
      },
      "required": [
        "pred",
        "args"
      ]
    },
    "AttestDecl": {
      "description": "`attest <question>`.",
      "type": "object",
      "properties": {
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "description": "The question being attested.",
          "$ref": "#/$defs/Ident"
        }
      },
      "required": [
        "question"
      ]
    },
    "AttrDecl": {
      "description": "`<subject>.<attr> = <value>`.",
      "type": "object",
      "properties": {
        "attr": {
          "description": "The slot name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "description": "The entity the slot is about.",
          "$ref": "#/$defs/Ident"
        },
        "value": {
          "description": "The slot value.",
          "$ref": "#/$defs/Term"
        }
      },
      "required": [
        "subject",
        "attr",
        "value"
      ]
    },
    "BannedDecl": {
      "description": "`banned <word> <d-id> \"<reason>\"`.",
      "type": "object",
      "properties": {
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "description": "The reason, if written.",
          "type": [
            "string",
            "null"
          ]
        },
        "word": {
          "description": "The banned word.",
          "$ref": "#/$defs/Ident"
        }
      },
      "required": [
        "word"
      ]
    },
    "BeforeDecl": {
      "description": "`before <earlier> -> <later>`.",
      "type": "object",
      "properties": {
        "earlier": {
          "description": "The event that comes first.",
          "$ref": "#/$defs/Ident"
        },
        "later": {
          "description": "The event that comes after.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "earlier",
        "later"
      ]
    },
    "CitationRef": {
      "description": "A reference to a decision-ledger entry, e.g. `D-0042`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The cited decision identifier.",
          "$ref": "#/$defs/Ident"
        }
      },
      "required": [
        "id"
      ]
    },
    "Clause": {
      "description": "One normalized interior line of a keyword-fronted block.",
      "type": "object",
      "properties": {
        "span": {
          "description": "Where the clause appears in source.",
          "$ref": "#/$defs/Span"
        },
        "text": {
          "description": "The clause text, whitespace-normalized.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "span"
      ]
    },
    "CondExpr": {
      "description": "A boolean condition over named hypotheses that gates a claim.",
      "oneOf": [
        {
          "description": "The named hypothesis holds.",
          "type": "object",
          "properties": {
            "Hyp": {
              "$ref": "#/$defs/Ident"
            }
          },
          "additionalProperties": false,
          "required": [
            "Hyp"
          ]
        },
        {
          "description": "Negation.",
          "type": "object",
          "properties": {
            "Not": {
              "$ref": "#/$defs/CondExpr"
            }
          },
          "additionalProperties": false,
          "required": [
            "Not"
          ]
        },
        {
          "description": "Conjunction of sub-conditions.",
          "type": "object",
          "properties": {
            "And": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CondExpr"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "And"
          ]
        },
        {
          "description": "Disjunction of sub-conditions.",
          "type": "object",
          "properties": {
            "Or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CondExpr"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "Or"
          ]
        }
      ]
    },
    "CycleDecl": {
      "description": "`cycle <name>(<modulus>) [= <spokes>]`.",
      "type": "object",
      "properties": {
        "modulus": {
          "description": "The cycle modulus, if written (`cycle tide(4)`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "name": {
          "description": "The cycle name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "spokes": {
          "description": "The ordered spoke names around the cycle.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ident"
          }
        }
      },
      "required": [
        "name",
        "spokes"
      ]
    },
    "Decl": {
      "description": "A top-level declaration.\n\nThe gentle subset — [`Entity`](Decl::Entity), [`Attr`](Decl::Attr),\n[`Fact`](Decl::Fact), [`Question`](Decl::Question), [`Before`](Decl::Before),\n[`Hypothesis`](Decl::Hypothesis) — is fully typed. The expert tier keeps a\ntyped header and a captured [`Clause`] body.",
      "oneOf": [
        {
          "description": "`era|place|person|thing|event <name> [\"label\"] …` — a world entity.",
          "type": "object",
          "properties": {
            "Entity": {
              "$ref": "#/$defs/EntityDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Entity"
          ]
        },
        {
          "description": "`<subject>.<attr> = <value>` — a slot fact about an entity.",
          "type": "object",
          "properties": {
            "Attr": {
              "$ref": "#/$defs/AttrDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Attr"
          ]
        },
        {
          "description": "`<pred>(<args>)` or `fact <subj> <pred> <obj>` — a ground relation.",
          "type": "object",
          "properties": {
            "Fact": {
              "$ref": "#/$defs/FactDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Fact"
          ]
        },
        {
          "description": "`question <name> \"<prompt>\"` with its options.",
          "type": "object",
          "properties": {
            "Question": {
              "$ref": "#/$defs/QuestionDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Question"
          ]
        },
        {
          "description": "`before <earlier> -> <later>` — a timeline ordering.",
          "type": "object",
          "properties": {
            "Before": {
              "$ref": "#/$defs/BeforeDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Before"
          ]
        },
        {
          "description": "`hypothesis <name> \"<statement>\"` — a named speculative premise.",
          "type": "object",
          "properties": {
            "Hypothesis": {
              "$ref": "#/$defs/HypothesisDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Hypothesis"
          ]
        },
        {
          "description": "`use <target>` — import another scope's surface.",
          "type": "object",
          "properties": {
            "Use": {
              "$ref": "#/$defs/UseDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Use"
          ]
        },
        {
          "description": "`kind <name>` — declare an entity kind.",
          "type": "object",
          "properties": {
            "Kind": {
              "$ref": "#/$defs/KindDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Kind"
          ]
        },
        {
          "description": "`rule <name> [over <domain>] …` — a checker rule (world, order, or season).",
          "type": "object",
          "properties": {
            "Rule": {
              "$ref": "#/$defs/RuleDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Rule"
          ]
        },
        {
          "description": "`state <name> = <value> …` — a time-varying property.",
          "type": "object",
          "properties": {
            "State": {
              "$ref": "#/$defs/StateDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "State"
          ]
        },
        {
          "description": "`cycle <name>(<modulus>) = <spokes>` — a cyclic time structure.",
          "type": "object",
          "properties": {
            "Cycle": {
              "$ref": "#/$defs/CycleDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Cycle"
          ]
        },
        {
          "description": "`fork <question>` — an open creative fork.",
          "type": "object",
          "properties": {
            "Fork": {
              "$ref": "#/$defs/ForkDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Fork"
          ]
        },
        {
          "description": "`practice <name> { … }` — a resource-tracked practice.",
          "type": "object",
          "properties": {
            "Practice": {
              "$ref": "#/$defs/PracticeDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Practice"
          ]
        },
        {
          "description": "`dialect <name> { … }` — a diction dialect.",
          "type": "object",
          "properties": {
            "Dialect": {
              "$ref": "#/$defs/DialectDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Dialect"
          ]
        },
        {
          "description": "`word <name>` — a coined term.",
          "type": "object",
          "properties": {
            "Word": {
              "$ref": "#/$defs/WordDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Word"
          ]
        },
        {
          "description": "`name-part <name>` — a naming-layer name-part.",
          "type": "object",
          "properties": {
            "NamePart": {
              "$ref": "#/$defs/NamePartDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "NamePart"
          ]
        },
        {
          "description": "`draft <name>` — a draft payload binding.",
          "type": "object",
          "properties": {
            "Draft": {
              "$ref": "#/$defs/DraftDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Draft"
          ]
        },
        {
          "description": "`attest <question>` — an attestation request.",
          "type": "object",
          "properties": {
            "Attest": {
              "$ref": "#/$defs/AttestDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Attest"
          ]
        },
        {
          "description": "`export <profile>` — an export directive.",
          "type": "object",
          "properties": {
            "Export": {
              "$ref": "#/$defs/ExportDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Export"
          ]
        },
        {
          "description": "`name <name> \"<label>\" …` — a composed proper name.",
          "type": "object",
          "properties": {
            "Name": {
              "$ref": "#/$defs/NameDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Name"
          ]
        },
        {
          "description": "`term <name> \"<label>\"` — a coined lexicon term.",
          "type": "object",
          "properties": {
            "Term": {
              "$ref": "#/$defs/TermDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Term"
          ]
        },
        {
          "description": "`banned <word> <d-id> \"<reason>\"` — a banned in-world word.",
          "type": "object",
          "properties": {
            "Banned": {
              "$ref": "#/$defs/BannedDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Banned"
          ]
        },
        {
          "description": "`narration <role> <era>` — a narrative-vantage declaration.",
          "type": "object",
          "properties": {
            "Narration": {
              "$ref": "#/$defs/NarrationDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Narration"
          ]
        },
        {
          "description": "`variant <path>` — a lore variant of an artifact.",
          "type": "object",
          "properties": {
            "Variant": {
              "$ref": "#/$defs/VariantDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Variant"
          ]
        },
        {
          "description": "`ratify <d-id> { … }` — a hypothesis-bundle ratification.",
          "type": "object",
          "properties": {
            "Ratify": {
              "$ref": "#/$defs/RatifyDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Ratify"
          ]
        },
        {
          "description": "`principle <name> …` — a craft principle.",
          "type": "object",
          "properties": {
            "Principle": {
              "$ref": "#/$defs/PrincipleDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Principle"
          ]
        },
        {
          "description": "`proof <name> … { … }` — a casting proof block.",
          "type": "object",
          "properties": {
            "Proof": {
              "$ref": "#/$defs/ProofDecl"
            }
          },
          "additionalProperties": false,
          "required": [
            "Proof"
          ]
        }
      ]
    },
    "DialectDecl": {
      "description": "`dialect <name> [\"label\"] { … }`.",
      "type": "object",
      "properties": {
        "body": {
          "description": "The captured body clauses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          }
        },
        "label": {
          "description": "The display label, if written.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The dialect name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "body"
      ]
    },
    "DraftDecl": {
      "description": "`draft <name>`.",
      "type": "object",
      "properties": {
        "body": {
          "description": "The captured body clauses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          }
        },
        "name": {
          "description": "The draft name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "body"
      ]
    },
    "EntityDecl": {
      "description": "`era|place|person|thing|event <name> [\"label\"] [time] [provenance]`.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Which kind of entity this is.",
          "$ref": "#/$defs/EntityKind"
        },
        "label": {
          "description": "The display label, if written.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The entity name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "slots": {
          "description": "Indented slot facts written beneath the entity.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttrDecl"
          }
        },
        "time": {
          "description": "A temporal clause, if written.",
          "anyOf": [
            {
              "$ref": "#/$defs/TimeClause"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "slots"
      ]
    },
    "EntityKind": {
      "description": "The five world-entity kinds.",
      "oneOf": [
        {
          "description": "`era` — a named span of time.",
          "type": "string",
          "const": "Era"
        },
        {
          "description": "`place` — a location.",
          "type": "string",
          "const": "Place"
        },
        {
          "description": "`person` — a person.",
          "type": "string",
          "const": "Person"
        },
        {
          "description": "`thing` — an artifact or object.",
          "type": "string",
          "const": "Thing"
        },
        {
          "description": "`event` — a point on the timeline.",
          "type": "string",
          "const": "Event"
        }
      ]
    },
    "ExportDecl": {
      "description": "`export <profile>`.",
      "type": "object",
      "properties": {
        "body": {
          "description": "The captured body clauses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          }
        },
        "profile": {
          "description": "The export profile name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profile",
        "body"
      ]
    },
    "FactDecl": {
      "description": "`<pred>(<args>)` or `fact <subj> <pred> <obj>`.",
      "type": "object",
      "properties": {
        "atom": {
          "description": "The asserted atom.",
          "$ref": "#/$defs/AtomExpr"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "triple": {
          "description": "Whether the surface used the leading `fact` keyword (triple form).",
          "type": "boolean"
        }
      },
      "required": [
        "atom",
        "triple"
      ]
    },
    "FileId": {
      "description": "Identifier for a source file within a compilation.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ForkDecl": {
      "description": "`fork <question>` with its options and body.",
      "type": "object",
      "properties": {
        "body": {
          "description": "Any other captured body clauses (`suppose …`, `add fact …`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          }
        },
        "options": {
          "description": "The candidate options.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionClause"
          }
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "description": "The open question.",
          "$ref": "#/$defs/Ident"
        }
      },
      "required": [
        "question",
        "options",
        "body"
      ]
    },
    "HypothesisDecl": {
      "description": "`hypothesis <name> \"<statement>\"`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The hypothesis name.",
          "$ref": "#/$defs/Ident"
        },
        "statement": {
          "description": "The statement text, if written.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Ident": {
      "description": "A named identifier with its source span.",
      "type": "object",
      "properties": {
        "span": {
          "description": "Where the identifier appears in source.",
          "$ref": "#/$defs/Span"
        },
        "text": {
          "description": "The identifier text as written.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "span"
      ]
    },
    "KindDecl": {
      "description": "`kind <name>`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The kind name.",
          "$ref": "#/$defs/Ident"
        },
        "provenance": {
          "description": "Provenance annotation, if any.",
