scope runes

ratify d-0201
ratify d-0202
ratify d-0203
ratify d-0205
dialect old-norse "the Old Norse tongue" decided d-0201 {
  basis attested "Old Norse / Old West Norse"
  vowels a e i o u y
  endings -r -i -a -unn
  cluster-max 2
  stress initial
  name-kind person.given = given-proto given-deutero
  name-part sig "victory" role given-proto decided d-0201
  name-part thor "the thunder-god" role given-proto decided d-0201
  name-part gud "god" role given-proto decided d-0201
  name-part run "rune, secret" role given-deutero decided d-0201
  name-part ulf "wolf" role given-deutero decided d-0201
  name-part mund "hand, protection" role given-deutero decided d-0201
}
name sigrun "Sigrun" person.given in old-norse
  = given-proto sig + given-deutero run
  bearer the-seeress decided d-0202
name thorulf "Thorulf" person.given in old-norse
  = given-proto thor + given-deutero ulf
  bearer the-wanderer decided d-0202
name gudmund "Gudmund" person.given in old-norse
  = given-proto gud + given-deutero mund
  bearer heimdall decided d-0202
word runestave "rune-stave"  = given-deutero run decided d-0203
term the-elder-futhark "the four-and-twenty carved staves by which fate is read and worked" decided d-0203
hypothesis h-loan-name "the Norse tongue took a hero-name from the tongue over the sea"
name-part har "grey, hoary" role given-proto proposed agent:factory/naming-run-0721 assumes h-loan-name
name harmund "Harmund" person.given in old-norse
  = given-proto har + given-deutero mund
  proposed agent:factory/naming-run-0721 assumes h-loan-name
ratify d-0205 {
  h-loan-name := true
}
